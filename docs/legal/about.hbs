<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>XL-View third-party licenses</title>
  <style>
    body {
      font-family: sans-serif;
      line-height: 1.5;
      margin: 2rem auto;
      max-width: 72rem;
      padding: 0 1rem;
    }

    a {
      color: inherit;
    }

    section {
      border-top: 1px solid #888;
      margin-top: 2rem;
      padding-top: 1rem;
    }

    pre {
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }
  </style>
</head>
<body>
  <main>
    <h1>XL-View third-party licenses</h1>
    <p>
      This file contains license information for XL-View and the third-party
      Rust packages used to build it.
    </p>

    <h2>License summary</h2>
    <ul>
    {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> (uses: {{count}})</li>
    {{/each}}
    </ul>

    {{#each licenses}}
    <section>
      {{#if first_of_kind}}
      <h2 id="{{id}}">{{name}}</h2>
      {{/if}}
      <h3>Used by</h3>
      <ul>
      {{#each used_by}}
        <li>
          <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">
            {{crate.name}} {{crate.version}}
          </a>
        </li>
      {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
    {{/each}}
  </main>
</body>
</html>
